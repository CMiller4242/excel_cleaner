{
  "id": "zoominfo_healthcare_evs",
  "name": "ZoomInfo - Healthcare/EVS Export",
  "description": "Standardize ZoomInfo Healthcare/EVS export to standard mailing list format (10 columns)",
  "category": "ZoomInfo",
  "file_type": "ZoomInfo",
  "format_variant": "Healthcare/EVS",
  "version": "1.1",
  "expected_columns": [
    "First Name",
    "Last Name",
    "Job Title",
    "Direct Phone Number",
    "Email Address",
    "Person Street",
    "Person City",
    "Person State",
    "Person Zip Code",
    "Company Name",
    "ZoomInfo Contact ID"
  ],
  "operations": [
    {
      "operation_id": "clean_remove_blank_rows",
      "parameters": {},
      "order": 0,
      "enabled": true,
      "description": "Step 1: Remove completely empty rows",
      "editable": false,
      "required": true
    },
    {
      "operation_id": "clean_remove_columns",
      "parameters": {
        "columns": [
          "ZoomInfo Contact ID",
          "Middle Name",
          "Salutation",
          "Suffix",
          "Management Level",
          "Job Start Date",
          "Job Function",
          "Department",
          "Company Division Name",
          "Email Domain",
          "Mobile phone",
          "Highest Level of Education",
          "Contact Accuracy Score",
          "Contact Accuracy Grade",
          "ZoomInfo Contact Profile URL",
          "LinkedIn Contact Profile URL",
          "Notice Provided Date",
          "Country",
          "ZoomInfo Company ID",
          "Website",
          "Founded Year",
          "Company HQ Phone",
          "Fax",
          "Ticker",
          "Revenue (in 000s USD)",
          "Revenue Range (in USD)",
          "Employees",
          "Employee Range",
          "SIC Code 1",
          "SIC Code 2",
          "SIC Codes",
          "NAICS Code 1",
          "NAICS Code 2",
          "NAICS Codes",
          "Primary Industry",
          "Primary Sub-Industry",
          "All Industries",
          "All Sub-Industries",
          "Industry Hierarchical Category",
          "Secondary Industry Hierarchical Category",
          "Alexa Rank",
          "ZoomInfo Company Profile URL",
          "LinkedIn Company Profile URL",
          "Facebook Company Profile URL",
          "Twitter Company Profile URL",
          "Ownership Type",
          "Business Model",
          "Certified Active Company",
          "Certification Date",
          "Total Funding Amount (in 000s USD)",
          "Recent Funding Amount (in 000s USD)",
          "Recent Funding Round",
          "Recent Funding Date",
          "Recent Investors",
          "All Investors",
          "Company Street Address",
          "Company City",
          "Company State",
          "Company Zip Code",
          "Company Country",
          "Full Address",
          "Number of Locations",
          "Query Name"
        ]
      },
      "order": 1,
      "enabled": true,
      "description": "Step 2: Remove 63 non-standard ZoomInfo columns (keep only the 11 columns needed)",
      "editable": true,
      "required": false,
      "notes": "This removes all unnecessary ZoomInfo metadata and company info columns early to simplify processing"
    },
    {
      "operation_id": "text_concatenate",
      "parameters": {
        "columns": ["First Name", "Last Name"],
        "separator": " ",
        "new_column": "Contact",
        "remove_original": true
      },
      "order": 2,
      "enabled": true,
      "description": "Step 3: Combine First Name + Last Name → Contact",
      "editable": true,
      "required": true
    },
    {
      "operation_id": "zoominfo_split_address",
      "parameters": {
        "source_column": "Person Street",
        "suite_keywords": "Ste,Suite,Suites,Unit,Units,Apt,Apartment,Bldg,Building,Floor,Flr",
        "address1_column": "Address 1",
        "address2_column": "Address 2",
        "remove_original": true
      },
      "order": 3,
      "enabled": true,
      "description": "Step 4: Split Person Street → Address 1 (street) + Address 2 (suite/unit)",
      "editable": true,
      "required": true
    },
    {
      "operation_id": "text_rename_batch",
      "parameters": {
        "mappings": {
          "Person City": "City",
          "Person State": "State",
          "Person Zip Code": "Zip",
          "Job Title": "Title",
          "Direct Phone Number": "Phone",
          "Email Address": "Email",
          "Company Name": "Company"
        }
      },
      "order": 4,
      "enabled": true,
      "description": "Step 5: Rename 7 columns to standard format",
      "editable": true,
      "required": true
    },
    {
      "operation_id": "zoominfo_state_converter",
      "parameters": {
        "column": "State",
        "flag_unconverted": false
      },
      "order": 5,
      "enabled": true,
      "description": "Step 6: Convert state names to 2-letter codes (Ohio → OH, Illinois → IL)",
      "editable": true,
      "required": true
    },
    {
      "operation_id": "remove_excluded_states",
      "parameters": {
        "column": "State",
        "excluded_states": "AK,HI,PR,VI"
      },
      "order": 6,
      "enabled": true,
      "description": "Step 7: Remove Alaska, Hawaii, Puerto Rico, Virgin Islands",
      "editable": true,
      "required": true
    },
    {
      "operation_id": "data_remove_rows_if",
      "parameters": {
        "column": "Address 1",
        "condition": "is_blank"
      },
      "order": 7,
      "enabled": true,
      "description": "Step 8: Remove rows with blank Address 1",
      "editable": true,
      "required": true
    },
    {
      "operation_id": "data_reorder_columns",
      "parameters": {
        "column_order": [
          "Company",
          "Address 1",
          "Address 2",
          "City",
          "State",
          "Zip",
          "Phone",
          "Contact",
          "Title",
          "Email"
        ],
        "keep_unlisted": false
      },
      "order": 8,
      "enabled": true,
      "description": "Step 9: Reorder columns to standard format (10 columns total)",
      "editable": true,
      "required": true
    }
  ],
  "created_at": "2025-11-19T00:00:00",
  "updated_at": "2025-11-19T02:00:00",
  "author": "system",
  "usage_count": 0,
  "is_system": true,
  "expected_output": {
    "columns": 10,
    "column_names": [
      "Company",
      "Address 1",
      "Address 2",
      "City",
      "State",
      "Zip",
      "Phone",
      "Contact",
      "Title",
      "Email"
    ],
    "filters_applied": [
      "No Alaska, Hawaii, PR, VI states",
      "No blank Address 1",
      "States converted to 2-letter codes",
      "Addresses split into street + suite"
    ]
  },
  "notes": "This preset transforms ZoomInfo Healthcare/EVS exports (typically 73 columns, 1000+ rows) into a clean 10-column mailing list. Expected row reduction: 10-30% due to excluded states and blank addresses. Operations execute in optimized order: remove unnecessary columns early, then transform remaining columns, filter rows, and reorder to final format."
}
