          "Query Name"
        ]
      },
      "order": 13,
      "enabled": true,
      "description": "Phase 8: Remove all non-standard ZoomInfo columns (63 columns)",
      "editable": true,
      "required": false,
      "notes": "You can edit this list if your export has different columns. This removes ZoomInfo IDs, URLs, industry codes, and company metadata."
    },
    {
      "operation_id": "data_reorder_columns",
      "parameters": {
        "column_order": [
          "Company",
          "Address 1",
          "Address 2",
          "City",
          "State",
          "Zip",
          "Phone",
          "Contact",
          "Title",
          "Email"
        ]
      },
