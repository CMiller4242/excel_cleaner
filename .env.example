# Clean Sheet Configuration Example
# Copy this file to .env and update with your values

# MongoDB Connection String (REQUIRED)
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/

# Anthropic API Key (OPTIONAL - for AI Assistant features)
# Get this from: https://console.anthropic.com/
# Leave blank if you don't need AI features
ANTHROPIC_API_KEY=

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================
#
# 1. Copy this file: .env.example → .env
# 2. Edit the MONGODB_URI with your actual connection string
# 3. (Optional) Add your Anthropic API key for AI features
# 4. Save and run CleanSheet.exe
#
# For detailed setup instructions, see SETUP.md
#
# SECURITY NOTE:
# - Keep this file secure (contains credentials)
# - Never commit .env to version control
# - .env is already in .gitignore
# ============================================================
